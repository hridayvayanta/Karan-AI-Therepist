# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id_for_karan

# OpenAI (Whisper Speech-to-Text)
OPENAI_API_KEY=your_openai_api_key

# Pinecone (Vector Memory)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=karan-memory

# Database (PostgreSQL via Railway or Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/karan_db"

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_32chars
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (Persona Photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Karan Persona Photo URL (upload to Cloudinary and paste URL here)
NEXT_PUBLIC_KARAN_PHOTO_URL=https://res.cloudinary.com/your_cloud/image/upload/karan.jpg
